# Exchange API Configuration
# Kraken is the default because it doesn't geo-block cloud/datacenter IPs
# (GitHub Codespaces, most VPS providers). Binance.com returns HTTP 451
# "restricted location" errors from those IPs regardless of your own
# location -- if you want Binance specifically, run the bot from your own
# machine, or use EXCHANGE=binanceus if you're a US-based Binance.US user.
EXCHANGE=kraken
API_KEY=your_api_key_here
API_SECRET=your_api_secret_here

# Trading Parameters
SYMBOL=BTC/USD
TIMEFRAME=1h
INITIAL_BALANCE=1000
RISK_PER_TRADE=0.02

# How often the bot runs a cycle, in seconds. Defaults to the TIMEFRAME's
# candle length if unset (e.g. 3600 for 1h). Lower this for faster testing.
# POLL_INTERVAL_SECONDS=3600

# Safety gate for real money. Both of these must be set to place real orders;
# otherwise the bot always runs in paper-trading mode (simulated fills only).
LIVE_TRADING=false
# CONFIRM_LIVE_TRADING=YES_I_UNDERSTAND_THE_RISK

# Model Configuration
MODEL_PATH=./models/trading_model.keras
LOOKBACK_WINDOW=60
PREDICTION_THRESHOLD=0.55

# Logging
LOG_LEVEL=INFO
LOG_FILE=trading_bot.log

# Telegram Alerts (Optional)
# Set both to get buy/sell/error alerts. Create a bot via @BotFather to get
# TELEGRAM_BOT_TOKEN. For TELEGRAM_CHAT_ID: for a DM, message the bot once and
# check https://api.telegram.org/bot<token>/getUpdates; for a channel, add the
# bot as an admin and use the channel's numeric ID (looks like -100xxxxxxxxxx)
# or its @username.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Not yet implemented -- reserved for future use.
DISCORD_WEBHOOK_URL=